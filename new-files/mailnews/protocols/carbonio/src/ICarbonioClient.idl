#include "nsISupports.idl"

interface nsIMsgIncomingServer;
interface nsIInputStream;
interface nsIUrlListener;
interface nsIURI;

interface ICarbonioFolderListener;
interface ICarbonioMessageFetchListener;

/**
 * A client for communicating with a Carbonio server (SOAP-over-JSON API,
 * `urn:zimbraSoap`).
 *
 * This interface bridges the foreign function interface between the C++
 * components of the Carbonio protocol implementation and the Rust client
 * implementation (`carbonio_xpcom`).
 *
 * Modeled after `IExchangeClient`, trimmed to phase 1 scope: read-only
 * account (authentication, folder hierarchy sync, message retrieval). No
 * folder/message mutation operations yet (create, delete, move, copy,
 * mark as read/junk, ...) - those belong to a later phase.
 */
[scriptable, uuid(8f1d6e3a-4b7a-4b9a-9b3a-1e6c2f7a9d10)]
interface ICarbonioClient : nsISupports
{
  /**
   * Whether the client is currently running.
   *
   * False if `initialize()` hasn't been called yet, or if `shutdown()` has
   * been called.
   */
  readonly attribute boolean running;

  /**
   * Whether the client is not currently processing any operation and is
   * fully waiting for one to be triggered.
   *
   * If `running` is `false`, `idle` is also `false`.
   */
  readonly attribute boolean idle;

  /**
   * Initializes a new client with the host address and credentials needed to
   * communicate with a Carbonio server.
   *
   * @param endpoint - The full URL to the server's SOAP endpoint, e.g.
   *   `https://mail.example.com/service/soap` (confirmed empirically - see
   *   the connector repo's phase 1 spec doc).
   * @param server - The incoming server entity corresponding to a
   *   Carbonio-capable account. Used to read the account's username and
   *   password.
   */
  void initialize(in AUTF8String endpoint, in nsIMsgIncomingServer server);

  /**
   * Shuts down the client.
   *
   * This method might run asynchronously; there is no guarantee the client
   * won't emit network traffic after it returns (consumers can check
   * `running` to see when the client has fully stopped).
   */
  void shutdown();

  /**
   * Checks that the current client configuration is able to authenticate
   * against the Carbonio server (i.e. performs an `AuthRequest`).
   *
   * @param listener - Listener to communicate the success or failure of the
   *   check.
   * @returns The client's SOAP endpoint URL.
   */
  nsIURI checkConnectivity(in nsIUrlListener listener);

  /**
   * Synchronizes the local folder listing with changes made on the remote
   * Carbonio server.
   *
   * Confirmed empirically (see the connector repo's phase 1 spec doc): an
   * initial sync (empty `syncStateToken`) returns the full folder tree; a
   * subsequent sync returns only folders that changed since the given
   * token, each carrying current state (not a change log) - the listener is
   * responsible for deciding "created" vs "updated" by checking whether it
   * already knows the folder id locally.
   *
   * @param listener - Listener for communicating changes to the folder list
   *   and to the recorded synchronization state.
   * @param syncStateToken - A synchronization state token provided by a
   *   prior sync, or an empty string to indicate an initial sync.
   */
  void syncFolderHierarchy(in ICarbonioFolderListener listener, in AUTF8String syncStateToken);

  /**
   * Retrieves the raw RFC822 MIME content of a message on the Carbonio
   * server.
   *
   * Confirmed empirically: this requires the underlying `GetMsgRequest` to
   * be sent with `raw: 1` to receive the raw MIME source rather than
   * Carbonio's parsed representation - the Rust implementation always does
   * this.
   *
   * @param listener - Listener to communicate the operation's state and
   *   status, as well as the message's content, to the consumer.
   * @param id - The id of the message to fetch.
   */
  void getMessage(in ICarbonioMessageFetchListener listener, in AUTF8String id);
};

/**
 * Callbacks for folder hierarchy synchronization.
 *
 * Modeled after `IExchangeFolderListener` (see that interface for the
 * general contract) - trimmed to what phase 1 needs.
 */
[scriptable, uuid(2d3a6f4e-8c1b-4a2e-9e6a-7b5d3c1f8a22)]
interface ICarbonioFolderListener : nsISupports
{
  /**
   * Called on the first sync when we have requested and received the id for
   * the account's mailbox root folder (Carbonio folder id `1`, "USER_ROOT" -
   * confirmed empirically, see the phase 1 spec doc).
   *
   * @param id - The root folder's id.
   */
  void onNewRootFolder(in AUTF8String id);

  /**
   * Called for a folder that is new or has changed (renamed and/or moved)
   * on the server since the last sync.
   *
   * Confirmed empirically: Carbonio's `SyncRequest` reports current state,
   * not a change log, so this single callback covers both "created" and
   * "updated" - implementations are expected to look the id up locally
   * first (same approach as EWS's `FindFolderWithId`) to decide which case
   * they're in.
   *
   * @param id - The folder's id.
   * @param parentId - The id of the folder's parent. Empty only for the
   *   account's technical root (Carbonio folder id `11`), which has no
   *   local equivalent.
   * @param name - The folder's name.
   * @param isMailFolder - Best-effort determination of whether this is a
   *   mail folder as opposed to a calendar/contacts/tasks/tag folder (see
   *   the phase 1 spec doc for the current caveats on this heuristic).
   */
  void onFolderUpserted(in AUTF8String id, in AUTF8String parentId, in AUTF8String name, in boolean isMailFolder);

  /**
   * Called if an existing folder has been deleted on the server.
   *
   * @param id - The folder's id.
   */
  void onFolderDeleted(in AUTF8String id);

  /**
   * Called after a sync has completed, with the new sync state token to use
   * in future syncs.
   *
   * @param syncStateToken - The new sync state token.
   */
  void onSyncStateTokenChanged(in AUTF8String syncStateToken);

  /**
   * Called after processing everything there was to sync from the server.
   */
  void onSuccess();

  /**
   * Called if the sync operation failed.
   *
   * Simplified relative to EWS, which reports this via a second,
   * separately-implemented interface (`IExchangeFallibleOperationListener`,
   * composed onto the listener via multiple inheritance) - not needed here
   * given phase 1's narrower scope.
   *
   * @param status - The status describing the error.
   */
  void onOperationFailure(in nsresult status);
};

/**
 * A listener used when downloading a message's content.
 *
 * Modeled after `IExchangeMessageFetchListener`.
 */
[scriptable, uuid(6a9c2e1d-4f3b-4a8e-8d2a-1c5b7e9f3a44)]
interface ICarbonioMessageFetchListener : nsISupports
{
  void onFetchStart();
  void onFetchedDataAvailable(in nsIInputStream inputStream);
  void onFetchStop(in nsresult status);
};

/**
 * A listener for "simple" operations, which only report success or failure
 * to the consumer (used here for `ICarbonioIncomingServer::syncFolderHierarchy`).
 *
 * Simplified relative to EWS's `IExchangeSimpleOperationListener` +
 * `IExchangeFallibleOperationListener` pair (combined via multiple
 * inheritance): phase 1 has no operations that need to report newly
 * generated ids, so a single interface with both callbacks is enough here.
 */
[scriptable, uuid(3e8b1d5c-9a2f-4b6e-8c1d-2f4a6b8d9e11)]
interface ICarbonioSimpleOperationListener : nsISupports
{
  void onOperationSuccess();
  void onOperationFailure(in nsresult status);
};
