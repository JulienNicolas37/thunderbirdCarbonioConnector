UNIFIED_SOURCES += [
    "CarbonioFolder.cpp",
    "CarbonioIncomingServer.cpp",
    "CarbonioListeners.cpp",
    "CarbonioProtocolInfo.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

# As with EWS: these IDL files don't describe a public API for other
# components, but interfaces needed to interact with Rust - hence living
# here rather than in a separate "public" directory.
XPIDL_MODULE = "msgcarbonio"

XPIDL_SOURCES += [
    "ICarbonioClient.idl",
    "ICarbonioIncomingServer.idl",
]

FINAL_LIBRARY = "mail"
