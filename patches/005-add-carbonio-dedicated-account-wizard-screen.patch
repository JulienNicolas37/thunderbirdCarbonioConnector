# Purpose: adds a dedicated Carbonio screen to Thunderbird's account-setup
# wizard (Account Hub), reachable from a new "Carbonio" card on the initial
# protocol-select screen.
#
# Supersedes the standalone-protocol-in-manual-form approach from
# add-carbonio-to-account-wizard.patch (still included here, its changes to
# email-manual-incoming-form.mjs/accountHubEmailIncomingFormTemplate.inc.xhtml
# are harmless and kept for consistency, but Carbonio is no longer reached
# through that path in normal use).
#
# Design rationale: Carbonio is a single-endpoint protocol (one server
# handles both incoming and outgoing, via its own native SOAP/REST API - see
# docs/limitations-connues.md, "Hors périmètre phase 1", on the decision to
# use that API rather than exposing SMTP). The generic manual-config path
# (email-manual-incoming-form.mjs) assumes separate incoming/outgoing
# servers - the IMAP/POP3+SMTP model - and isn't a good fit. Thunderbird
# already made the same call for Exchange: "Microsoft" doesn't go through
# that generic form either, it gets its own dedicated screen
# (exchangeSettingsSubview -> exchangeTypeSubview). Carbonio follows the same
# principle, collapsed to a single step since there's no reliable
# auto-discovery to justify Exchange's two-stage flow (see
# docs/limitations-connues.md, "Pas d'autodiscover dédié à Carbonio", for the
# full mapping of that Microsoft flow and why it doesn't apply here).
#
# What this adds:
# - A 4th card ("Carbonio") on the protocol-select screen, alongside
#   IMAP/Microsoft/POP3.
# - A new single-step form (email-carbonio-settings.mjs +
#   accountHubEmailCarbonioSettingsTemplate.inc.xhtml): hostname, port,
#   connection security, username. No password field (handled by the shared
#   emailPasswordSubview step that follows, same as every other protocol).
#   No auth-method selector: Carbonio only supports plain username/password
#   against its own API for now, so config.incoming.auth is set directly to
#   passwordCleartext in code.
#   No outgoing/SMTP fields: config.outgoing is mirrored from config.incoming
#   so nothing downstream ends up with an empty outgoing server, consistent
#   with the native-API sending decision.
# - New "carbonioSettingsSubview" state wired into views/email.mjs (modeled
#   on "manualConfigSubview" for its state shape - a normal "Connect"-style
#   step - since "exchangeSettingsSubview" is specifically shaped around
#   triggering auto-discovery, which doesn't apply here).
# - Two new Fluent strings (account-hub-protocol-carbonio,
#   account-hub-email-carbonio-settings). Every other label in the new form
#   reuses existing generic strings already used by
#   email-manual-incoming-form.mjs (hostname/port/security/username labels
#   and their error messages) - no other new strings needed.
#
# No changes needed in CreateInBackend.sys.mjs or AccountConfig.sys.mjs -
# same reasoning as the previous patch: the @mozilla.org/messenger/server;1
# ?type=carbonio XPCOM contract is already registered, and isExchangeConfig()
# already correctly excludes "carbonio".
#
# Full context and the investigation that led here:
# docs/limitations-connues.md, section "Compte et création"
#
# Applies to: comm-central checkout (a separate nested Mercurial repo under
# mozilla-central's comm/ directory)
# Apply with (from inside the comm/ checkout):
#   hg import --no-commit patches/add-carbonio-dedicated-account-wizard-screen.patch
# or:
#   patch -p1 < patches/add-carbonio-dedicated-account-wizard-screen.patch

diff --git a/mail/components/accountcreation/content/widgets/email-carbonio-settings.mjs b/mail/components/accountcreation/content/widgets/email-carbonio-settings.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/accountcreation/content/widgets/email-carbonio-settings.mjs
@@ -0,0 +1,177 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { AccountCreationUtils } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/AccountCreationUtils.sys.mjs"
+);
+const { AccountConfig } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/AccountConfig.sys.mjs"
+);
+const { InputSanitizer } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/InputSanitizer.sys.mjs"
+);
+
+const { gAccountSetupLogger, standardPorts, assert } = AccountCreationUtils;
+
+import { AccountHubStep } from "./account-hub-step.mjs";
+import "./account-hub-select.mjs"; // eslint-disable-line import/no-unassigned-import
+
+/**
+ * Account Hub Carbonio Settings Form
+ * Template ID: #accountHubEmailCarbonioSettingsTemplate (from
+ * accountHubEmailCarbonioSettingsTemplate.inc.xhtml)
+ *
+ * A single-step incoming/outgoing configuration form for Carbonio accounts.
+ * Unlike email-manual-incoming-form.mjs, this is not paired with a separate
+ * outgoing (SMTP) step: Carbonio sends mail through its own native SOAP/REST
+ * API, not SMTP, so there is nothing to configure on the outgoing side.
+ *
+ * @tagname email-carbonio-settings
+ */
+class EmailCarbonioSettings extends AccountHubStep {
+  #form;
+  #hostname;
+  #port;
+  #connectionSecurity;
+  #username;
+  #currentConfig;
+  #edited = false;
+
+  connectedCallback() {
+    if (this.hasConnected) {
+      return;
+    }
+    this.hasConnected = true;
+
+    super.connectedCallback();
+
+    const template = document
+      .getElementById("accountHubEmailCarbonioSettingsTemplate")
+      .content.cloneNode(true);
+    this.appendChild(template);
+
+    this.#form = this.querySelector("#carbonioSettingsForm");
+    this.#hostname = this.querySelector("#carbonioHostname");
+    this.#port = this.querySelector("#carbonioPort");
+    this.#connectionSecurity = this.querySelector(
+      "#carbonioConnectionSecurity"
+    );
+    this.#username = this.querySelector("#carbonioUsername");
+
+    this.#hostname.addEventListener("input", () => this.#configChanged());
+    this.#port.addEventListener("input", () => this.#configChanged());
+    this.#connectionSecurity.addEventListener("change", () =>
+      this.#configChanged()
+    );
+    this.#username.addEventListener("input", () => this.#configChanged());
+  }
+
+  /**
+   * @param {AccountConfig} configData - The config to present to the user.
+   */
+  setState(configData) {
+    assert(configData instanceof AccountConfig);
+    this.#currentConfig = configData;
+
+    this.#hostname.value = configData.incoming.hostname || "";
+    this.#port.value = configData.incoming.port || 443;
+    this.#connectionSecurity.value = InputSanitizer.enum(
+      configData.incoming.socketType,
+      [0, 2, 3],
+      3
+    );
+    this.#username.value = configData.incoming.username || "";
+    this.#checkFormValidity();
+  }
+
+  resetState() {
+    this.#edited = false;
+  }
+
+  captureState() {
+    return {
+      config: this.getCarbonioUserConfig(),
+      edited: this.#edited,
+    };
+  }
+
+  /**
+   * Returns an Account Config object with the sanitized user-inputted data
+   * for a Carbonio configuration.
+   *
+   * @returns {AccountConfig}
+   */
+  getCarbonioUserConfig() {
+    const config = this.#currentConfig.copy();
+    config.source = AccountConfig.kSourceUser;
+    config.incoming.type = "carbonio";
+
+    try {
+      config.incoming.hostname = InputSanitizer.hostname(
+        this.#hostname.value
+      );
+      this.#hostname.setCustomValidity("");
+      this.#hostname.setAttribute("aria-invalid", false);
+    } catch (error) {
+      gAccountSetupLogger.warn(error);
+      this.#hostname.setCustomValidity(error._message);
+      this.#hostname.setAttribute("aria-invalid", true);
+    }
+
+    try {
+      config.incoming.port = InputSanitizer.integerRange(
+        this.#port.valueAsNumber,
+        1,
+        65535
+      );
+    } catch (error) {
+      config.incoming.port = undefined;
+      this.#port.setCustomValidity(error._message);
+      this.#port.setAttribute("aria-invalid", true);
+    }
+
+    config.incoming.socketType = InputSanitizer.integer(
+      this.#connectionSecurity.value
+    );
+
+    // Carbonio has a single native auth mode (username/password against its
+    // own SOAP API) - no OAuth/NTLM/Kerberos choice to expose here.
+    config.incoming.auth = Ci.nsMsgAuthMethod.passwordCleartext;
+
+    config.incoming.username = this.#username.value;
+    this.#username.setAttribute("aria-invalid", !this.#username.value);
+
+    // Carbonio sends mail through its own native API, not SMTP: mirror the
+    // incoming settings onto the outgoing config so nothing downstream ends
+    // up with an empty/invalid outgoing server.
+    config.outgoing = config.incoming;
+
+    return config;
+  }
+
+  #configChanged() {
+    this.#edited = true;
+    this.#checkFormValidity();
+  }
+
+  #checkFormValidity() {
+    let completed = false;
+    try {
+      completed =
+        !!this.getCarbonioUserConfig().incoming.hostname &&
+        this.#form.checkValidity();
+    } catch (error) {
+      // Just fetching config values here; fail silently.
+    }
+
+    this.dispatchEvent(
+      new CustomEvent("config-updated", {
+        bubbles: true,
+        detail: { completed },
+      })
+    );
+  }
+}
+
+customElements.define("email-carbonio-settings", EmailCarbonioSettings);
