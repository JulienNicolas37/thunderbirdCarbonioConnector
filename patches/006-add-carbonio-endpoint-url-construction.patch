# Purpose: fixes account creation failing at the password step with
# "0x80070057 (NS_ERROR_ILLEGAL_VALUE) [nsIMsgIncomingServer.verifyLogon]",
# discovered while testing add-carbonio-dedicated-account-wizard-screen.patch.
#
# Root cause: the account-wizard's dedicated Carbonio screen only ever
# collects hostname/port/socketType/username - it never had a way to
# populate the "carbonio_url" server preference that
# CarbonioIncomingServer::GetProtocolClient() reads to build the Carbonio
# client (see CarbonioIncomingServer.cpp, GetCarbonioUrl/Initialize - the
# endpoint is passed through as-is, with no path/scheme construction on the
# C++ or Rust side; carbonio_xpcom's soap.rs documents the expected format
# as the full SOAP endpoint, e.g. https://<host>/service/soap, confirmed
# empirically - see the phase 1 spec doc).
#
# Without "carbonio_url" ever being set, CarbonioClient::new() receives an
# empty/missing endpoint, which fails URL parsing - surfacing at
# verifyLogon() as NS_ERROR_ILLEGAL_VALUE, since that's the first place in
# the account-creation flow that actually exercises the client
# (verifyConfig() -> verifyLogon() -> GetProtocolClient() -> Initialize()).
#
# Two *separate* files independently set this kind of protocol-specific
# server preference before calling verifyLogon() / finishing account
# creation - CreateInBackend.sys.mjs (used on successful non-interactive
# creation) and ConfigVerifier.sys.mjs (used during the live verifyLogon()
# check itself, in the account-wizard flow this connector actually goes
# through). Both had the same owa_url/ews_url/eas_url pattern and both
# were missing a carbonio_url equivalent - fixing only one would have left
# the other broken depending on the exact path taken.
#
# Rather than duplicating the endpoint-construction logic in both files,
# it's added once as AccountConfig.prototype.buildCarbonioEndpointURL(),
# alongside the existing isExchangeConfig() - both files already import
# AccountConfig, so this avoids a third copy of the same string-building
# logic existing anywhere a future change (e.g. a different default port)
# would need to keep in sync.
#
# Note on scheme selection: plain-HTTP support (when the user picks "No
# encryption" for connection security) is only confirmed to work against
# the local test harness (CarbonioServer, used in xpcshell tests), not
# against a real deployment - see docs/limitations-connues.md. Kept here
# so that form choice has an actual effect rather than being silently
# ignored, but flagged as an assumption, not a validated fact.
#
# Full context: docs/limitations-connues.md, section "Compte et création".
# Supplements add-carbonio-dedicated-account-wizard-screen.patch (this fix
# was found while testing that patch) - apply both.
#
# Applies to: comm-central checkout (a separate nested Mercurial repo under
# mozilla-central's comm/ directory)
# Apply with (from inside the comm/ checkout):
#   hg import --no-commit patches/add-carbonio-endpoint-url-construction.patch
# or:
#   patch -p1 < patches/add-carbonio-endpoint-url-construction.patch

diff --git a/mail/components/accountcreation/modules/AccountConfig.sys.mjs b/mail/components/accountcreation/modules/AccountConfig.sys.mjs
--- a/mail/components/accountcreation/modules/AccountConfig.sys.mjs
+++ b/mail/components/accountcreation/modules/AccountConfig.sys.mjs
@@ -479,6 +479,32 @@ AccountConfig.prototype = {
   },
 
   /**
+   * Build the full Carbonio SOAP endpoint URL from this config's incoming
+   * hostname/port/socketType, e.g. `https://mail.example.com:443/service/soap`.
+   * Confirmed empirically that Carbonio expects the full endpoint including
+   * the `/service/soap` path - see carbonio_xpcom's soap.rs and the phase 1
+   * spec doc.
+   *
+   * @returns {string} The endpoint URL, or an empty string if hostname is
+   *   not set.
+   */
+  buildCarbonioEndpointURL() {
+    if (!this.incoming.hostname) {
+      return "";
+    }
+    // Plain-HTTP support is only confirmed against the local test harness
+    // (CarbonioServer), not against a real deployment - kept here so the
+    // "No encryption" connection-security choice has an actual effect
+    // rather than being silently ignored.
+    const scheme =
+      this.incoming.socketType === Ci.nsMsgSocketType.plain
+        ? "http"
+        : "https";
+    const port = this.incoming.port ? `:${this.incoming.port}` : "";
+    return `${scheme}://${this.incoming.hostname}${port}/service/soap`;
+  },
+
+  /**
    * Return the host for the current configuration, or null if it is not configured.
    *
    * Note that this prefers the computed value from the configured URL for
diff --git a/mail/components/accountcreation/modules/ConfigVerifier.sys.mjs b/mail/components/accountcreation/modules/ConfigVerifier.sys.mjs
--- a/mail/components/accountcreation/modules/ConfigVerifier.sys.mjs
+++ b/mail/components/accountcreation/modules/ConfigVerifier.sys.mjs
@@ -442,6 +442,12 @@ export class ConfigVerifier {
         if (config.incoming.easURL) {
           this.server.setStringValue("eas_url", config.incoming.easURL);
         }
+        if (config.incoming.type == "carbonio") {
+          this.server.setStringValue(
+            "carbonio_url",
+            config.buildCarbonioEndpointURL()
+          );
+        }
         lazy.CreateInBackend.applyExchangeOAuthSettings(
           this.server,
           config.incoming
diff --git a/mail/components/accountcreation/modules/CreateInBackend.sys.mjs b/mail/components/accountcreation/modules/CreateInBackend.sys.mjs
--- a/mail/components/accountcreation/modules/CreateInBackend.sys.mjs
+++ b/mail/components/accountcreation/modules/CreateInBackend.sys.mjs
@@ -120,6 +120,12 @@ async function createAccountInBackend(co
   if (config.incoming.easURL) {
     inServer.setStringValue("eas_url", config.incoming.easURL);
   }
+  if (config.incoming.type == "carbonio") {
+    inServer.setStringValue(
+      "carbonio_url",
+      config.buildCarbonioEndpointURL()
+    );
+  }
   applyExchangeOAuthSettings(inServer, config.incoming);
   inServer.valid = true;
